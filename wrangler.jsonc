// Cloudflare deploys MIAP from this file on every push to main (Workers Builds, see README).
// One Worker serves the site files AND relay/worker.js (news, attacks, memory).
{
  "name": "friday-relay",
  "main": "relay/worker.js",
  "compatibility_date": "2026-10-01",
  // Every file in the repo is a static asset except what .assetsignore lists.
  "assets": { "directory": ".", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "miap-memory", "database_id": "5a98a893-6cb8-47e8-acab-07cb72df4356" }
  ],
  // Workers AI for the briefing (free: 10,000 neurons a day; one briefing costs about 110)
  "ai": { "binding": "AI" },
  // hourly: memory snapshot. Every 5 min on weekdays, only in the UTC hours that hold the alert windows
  // (08:00-09:00 and 15:30-17:30 Brussels) in both winter (UTC+1) and summer (UTC+2) time: 72 runs a weekday, not 288 every day.
  // Cron runs in UTC and counts weekdays from 1 = Sunday, hence the names. tests/alerts.test.js checks the hours.
  "triggers": { "crons": ["0 * * * *", "*/5 6,7,13-16 * * mon-fri"] },
  "observability": { "enabled": true }
}
